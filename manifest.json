{
  "manifest_version": 3,
  "name": "Morse Code Translator",
  "version": "1.0",
  "description": "Translate text to Morse code and Morse code to text. Play sound, flash light, and download Morse audio.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Morse Code Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "morsecodetranslator@realbilalmd.com",
      "strict_min_version": "109.0"
    }
  }
}
